# Molecule managed: this image is test-only and is not a production package
# source.  Keep the image and repositories on the same historical Rocky minor
# release.  The image digest and the explicit coreutils NEVRA below are a
# single test fixture contract; do not replace either with a moving tag or
# an unpinned replacement transaction.
FROM --platform=linux/amd64 docker.io/rockylinux/rockylinux:9-ubi-init@sha256:b33dfee97df5b631945b9b04ffc2f4deb28862db927c86cb0afb94ef9861dfb5

LABEL io.idarsi.patroni-config.base-image="docker.io/rockylinux/rockylinux:9-ubi-init" \
      io.idarsi.patroni-config.base-digest="sha256:b33dfee97df5b631945b9b04ffc2f4deb28862db927c86cb0afb94ef9861dfb5" \
      io.idarsi.patroni-config.build-contract="rocky-9.8-bash-0:5.1.8-9.el9.x86_64-coreutils-0:8.32-40.el9.x86_64-v2"

RUN set -eu; \
    command -v curl >/dev/null; command -v gpg >/dev/null; \
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
      --output /tmp/RPM-GPG-KEY-Rocky-9 \
      https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9; \
    primary_fingerprint="$(gpg --batch --with-colons --show-keys /tmp/RPM-GPG-KEY-Rocky-9 | \
      awk -F: '$1 == "pub" { primary=1; next } primary && $1 == "fpr" { print $10; exit }')"; \
    test "${primary_fingerprint}" = "21CB256AE16FC54C6E652949702D426D350D275D"; \
    rpm --import /tmp/RPM-GPG-KEY-Rocky-9; \
    mkdir -p /etc/yum.repos.d.disabled; \
    for repo in /etc/yum.repos.d/*.repo; do [ -e "${repo}" ] || continue; mv -- "${repo}" /etc/yum.repos.d.disabled/; done; \
    printf '%s\n' \
      '[rocky-9.8-baseos]' 'name=Rocky Linux 9.8 - BaseOS' \
      'baseurl=https://dl.rockylinux.org/pub/rocky/9.8/BaseOS/$basearch/os/' \
      'enabled=1' 'sslverify=1' 'gpgcheck=1' 'repo_gpgcheck=1' \
      'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
      '[rocky-9.8-appstream]' 'name=Rocky Linux 9.8 - AppStream' \
      'baseurl=https://dl.rockylinux.org/pub/rocky/9.8/AppStream/$basearch/os/' \
      'enabled=1' 'sslverify=1' 'gpgcheck=1' 'repo_gpgcheck=1' \
      'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
      '[rocky-9.8-extras]' 'name=Rocky Linux 9.8 - Extras' \
      'baseurl=https://dl.rockylinux.org/pub/rocky/9.8/extras/$basearch/os/' \
      'enabled=1' 'sslverify=1' 'gpgcheck=1' 'repo_gpgcheck=1' \
      'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
      > /etc/yum.repos.d/rocky-9.8-snapshot.repo; \
     printf '%s\n' \
       '[crb]' 'name=Rocky Linux 9.8 - CRB' \
       'baseurl=https://dl.rockylinux.org/pub/rocky/9.8/CRB/$basearch/os/' \
       'enabled=0' 'sslverify=1' 'gpgcheck=1' 'repo_gpgcheck=1' \
       'gpgkey=https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9' \
       > /etc/yum.repos.d/rocky.repo; \
    test "$(uname -m)" = "x86_64"; \
    dnf --assumeyes --disablerepo='*' --enablerepo='rocky-9.8-baseos,rocky-9.8-appstream,rocky-9.8-extras' \
      swap coreutils-single coreutils-0:8.32-40.el9.x86_64; \
    test "$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' bash)" = \
      "bash-0:5.1.8-9.el9.x86_64"; \
    test "$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' coreutils)" = \
      "coreutils-0:8.32-40.el9.x86_64"; \
    test "$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' openssl)" = \
      "openssl-1:3.5.5-2.el9_8.x86_64"; \
    test "$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' acl)" = \
      "acl-0:2.3.1-4.el9.x86_64"; \
    test "$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' util-linux)" = \
      "util-linux-0:2.37.4-25.el9.x86_64"; \
    test "$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' python3)" = \
      "python3-0:3.9.25-7.el9_8.x86_64"; \
    test "$(rpm -q coreutils-single 2>/dev/null || true)" = "package coreutils-single is not installed"; \
    command -v bash >/dev/null; command -v openssl >/dev/null; command -v getfacl >/dev/null; \
    command -v setfacl >/dev/null; command -v namei >/dev/null; command -v python3 >/dev/null; \
    python3_path="$(/usr/bin/readlink -e -- /usr/bin/python3)"; \
    test -f "${python3_path}" && test ! -L "${python3_path}" && test -x "${python3_path}"; \
    dnf clean all; rm -rf /var/cache/dnf /tmp/RPM-GPG-KEY-Rocky-9
