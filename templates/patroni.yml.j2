scope: {{ pg_cluster.name }}
name: {{ pg_patroni_name }}

restapi:
  listen: {{ pg_patroni_restapi_endpoint_model.rendered_listener | to_json }}
  connect_address: {{ pg_patroni_restapi_endpoint_model.advertised_connect | to_json }}
  authentication:
    username: {{ pg_patroni.restapi.authentication.username | to_json }}
    password: {{ pg_patroni.restapi.authentication.password | to_json }}
{% if pg_patroni.restapi.allowlist is defined %}
  allowlist:
{% for address in pg_patroni.restapi.allowlist %}
    - {{ address | to_json }}
{% endfor %}
{% else %}
  allowlist:
{% for member in pg_cluster.members | unique(attribute='host') %}
    - {{ member.host | to_json }}
{% endfor %}
{% endif %}
{% if pg_patroni_restapi_endpoint_model.tls_enabled | default(false) | bool %}
  cafile: {{ pg_patroni_restapi_endpoint_model.cafile | to_json }}
  certfile: {{ pg_patroni_restapi_endpoint_model.certfile | to_json }}
  keyfile: {{ pg_patroni_restapi_endpoint_model.keyfile | to_json }}
  verify_client: {{ pg_patroni.restapi.verify_client | default('none') | to_json }}
{% endif %}

{% if pg_cluster.dcs.provider == 'etcd3' %}
etcd3:
  hosts: {{ pg_patroni_dcs_endpoint_model | map(attribute='rendered_endpoint') | map('regex_replace', '^https?://', '') | join(',') | to_json }}
{% if pg_patroni_dcs_proxy_model is mapping %}
  proxy: {{ pg_patroni_dcs_proxy_model.rendered_endpoint | to_json }}
{% endif %}
{% if pg_cluster.dcs.use_proxies is defined %}
  use_proxies: {{ pg_cluster.dcs.use_proxies | bool | lower }}
{% endif %}
{% if pg_cluster_dcs_model.protocol == 'https' %}
  protocol: {{ pg_cluster_dcs_model.protocol }}
  cacert: {{ pg_cluster_etcd_tls_effective.client.ca_file }}
  cert: {{ pg_cluster_etcd_tls_effective.client.cert_file }}
  key: {{ pg_cluster_etcd_tls_effective.client.key_file }}
{% endif %}
{% elif pg_cluster.dcs.provider == 'consul' %}
consul:
  hosts: {{ pg_patroni_dcs_endpoint_model | map(attribute='rendered_endpoint') | join(',') | to_json }}
{% elif pg_cluster.dcs.provider == 'kubernetes' %}
kubernetes:
  namespace: {{ pg_cluster.dcs.namespace | default('default') | to_json }}
  labels:
    app: {{ pg_cluster.name | to_json }}
{% endif %}

bootstrap:
{% if pg_patroni.pg_hba is defined %}
  pg_hba:
{% for pg_hba_line in pg_patroni.pg_hba %}
    - {{ pg_hba_line | to_json }}
{% endfor %}
{% endif %}
  dcs:
    ttl: {{ pg_patroni.ttl | default(30) }}
    loop_wait: {{ pg_patroni.loop_wait | default(10) }}
    retry_timeout: {{ pg_patroni.retry_timeout | default(10) }}
    maximum_lag_on_failover: {{ pg_patroni.maximum_lag_on_failover | default(1048576) }}
    synchronous_mode: {{ pg_patroni.synchronous_mode | default(false) | bool | lower }}
    postgresql:
      use_pg_rewind: {{ pg_patroni.use_pg_rewind | default(true) | bool | lower }}
      use_slots: {{ pg_patroni.use_slots | default(true) | bool | lower }}
      parameters:
        wal_level: replica
        hot_standby: 'on'
        max_wal_senders: {{ pg_replication_max_wal_senders }}
        max_replication_slots: {{ pg_replication_max_replication_slots }}

postgresql:
  listen: 0.0.0.0:{{ pg_instance_record.1.configuration.port | default(pg_default_port) }}
  connect_address: {{ pg_patroni_postgresql_connect_address_effective | to_json }}
  data_dir: {{ pg_bind_dir }}/{{ pg_version }}/{{ pg_instance }}
  custom_conf: {{ pg_patroni_config_directory }}/{{ pg_version }}-{{ pg_instance }}.base.conf
  bin_dir: /usr/pgsql-{{ pg_version }}/bin
  pgpass: {{ pg_bind_dir }}/{{ pg_version }}/.patroni-{{ pg_instance }}.pgpass
  authentication:
    superuser:
      username: postgres
      password: {{ (pg_patroni.postgresql | default({})).superuser_password | default('') | to_json }}
    replication:
      username: {{ (pg_patroni.postgresql | default({})).replication_username | default('replicator') }}
      password: {{ (pg_patroni.postgresql | default({})).replication_password | default(pg_patroni.replication_password | default('')) | to_json }}
