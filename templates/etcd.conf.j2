{% set etcd_tls = pg_etcd_config.tls | default({}) %}
ETCD_NAME={{ pg_etcd_member.name }}
ETCD_DATA_DIR={{ pg_etcd_config.data_dir | default(pg_etcd_data_directory) }}
ETCD_LISTEN_PEER_URLS=https://{{ pg_etcd_bind_address }}:2380
ETCD_INITIAL_ADVERTISE_PEER_URLS={{ pg_etcd_member.peer_url }}
ETCD_LISTEN_CLIENT_URLS=https://{{ pg_etcd_bind_address }}:2379
ETCD_ADVERTISE_CLIENT_URLS={{ pg_etcd_member.client_url }}
ETCD_INITIAL_CLUSTER_TOKEN={{ pg_etcd_config.initial_cluster_token }}
ETCD_INITIAL_CLUSTER={% for member in pg_etcd_config.members %}{{ member.name }}={{ member.peer_url }}{% if not loop.last %},{% endif %}{% endfor %}{{ '\n' }}
ETCD_INITIAL_CLUSTER_STATE={{ pg_etcd_config.initial_cluster_state | default(pg_etcd_initial_cluster_state) }}
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE={{ etcd_tls.client.ca_file }}
ETCD_CERT_FILE={{ etcd_tls.client.cert_file }}
ETCD_KEY_FILE={{ etcd_tls.client.key_file }}
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE={{ etcd_tls.peer.ca_file }}
ETCD_PEER_CERT_FILE={{ etcd_tls.peer.cert_file }}
ETCD_PEER_KEY_FILE={{ etcd_tls.peer.key_file }}
