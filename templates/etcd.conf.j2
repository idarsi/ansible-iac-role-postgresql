{% set etcd_tls = pg_cluster_etcd_tls_effective %}
ETCD_NAME={{ pg_etcd_member.name | trim | quote }}
ETCD_DATA_DIR={{ (pg_etcd_config.data_dir | default(pg_etcd_data_directory)) | quote }}
ETCD_LISTEN_PEER_URLS={{ ('https://' ~ ('[' ~ pg_etcd_bind_address_normalized ~ ']' if ':' in pg_etcd_bind_address_normalized else pg_etcd_bind_address_normalized) ~ ':2380') | quote }}
ETCD_INITIAL_ADVERTISE_PEER_URLS={{ pg_etcd_member.peer_url | trim | quote }}
ETCD_LISTEN_CLIENT_URLS={{ ('https://' ~ ('[' ~ pg_etcd_bind_address_normalized ~ ']' if ':' in pg_etcd_bind_address_normalized else pg_etcd_bind_address_normalized) ~ ':2379') | quote }}
ETCD_ADVERTISE_CLIENT_URLS={{ pg_etcd_member.client_url | trim | quote }}
ETCD_INITIAL_CLUSTER_TOKEN={{ pg_etcd_config.initial_cluster_token | trim | quote }}
ETCD_INITIAL_CLUSTER="{% for member in pg_etcd_config.members %}{{ member.name | trim }}={{ member.peer_url | trim }}{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE={{ (pg_etcd_config.initial_cluster_state | default(pg_etcd_initial_cluster_state)) | quote }}
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE={{ etcd_tls.client.ca_file | quote }}
ETCD_CERT_FILE={{ etcd_tls.client.cert_file | quote }}
ETCD_KEY_FILE={{ etcd_tls.client.key_file | quote }}
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE={{ etcd_tls.peer.ca_file | quote }}
ETCD_PEER_CERT_FILE={{ etcd_tls.peer.cert_file | quote }}
ETCD_PEER_KEY_FILE={{ etcd_tls.peer.key_file | quote }}
